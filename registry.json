      "css": {
        "@custom-variant dark": {
          "&:where(.dark, .dark *)": {
            "@slot": {}
          },
          "@media (prefers-color-scheme: dark)": {
            "&:where(:root:not(.light), :root:not(.light) *)": {
              "@slot": {}
            }
          }
        },
        ":root": {
          "color-scheme": "light"
        },
        ".dark": {
          "color-scheme": "dark"
        },
        "@media (prefers-color-scheme: dark)": {
          ":root:not(.light)": {
            "color-scheme": "dark",
            "--background": "#1b1a18",
            "--foreground": "#f5f4f2",
            "--card": "#252320",
            "--card-foreground": "#f5f4f2",
            "--popover": "#252320",
            "--popover-foreground": "#f5f4f2",
            "--primary": "#f5f4f2",
            "--primary-foreground": "#1b1a18",
            "--secondary": "#2c2a26",
            "--secondary-foreground": "#f5f4f2",
            "--muted": "#302e2a",
            "--muted-foreground": "#b7b3ab",
            "--accent": "#3d3a34",
            "--accent-foreground": "#f5f4f2",
            "--destructive": "#9b1c1f",
            "--destructive-foreground": "#f8d7d8",
            "--border": "#494640",
            "--input": "color-mix(in srgb, var(--foreground) 50%, var(--background))",
            "--field": "#211f1c",
            "--ring": "#f8b98a",
            "--focus": "#f8b98a",
            "--chart-1": "#f5f4f2",
            "--chart-2": "#b7b3ab",
            "--chart-3": "#f5a06a",
            "--chart-4": "#ee6018",
            "--chart-5": "#d4550f",
            "--sidebar": "#252320",
            "--sidebar-foreground": "#f5f4f2",
            "--sidebar-primary": "#f5f4f2",
            "--sidebar-primary-foreground": "#1b1a18",
            "--sidebar-accent": "#302e2a",
            "--sidebar-accent-foreground": "#f5f4f2",
            "--sidebar-border": "#494640",
            "--sidebar-ring": "#f5a06a",
            "--danger": "#f5a097",
            "--danger-tint": "#3d1f1c",
            "--danger-border": "#6e2d28",
            "--warning": "#e8b95b",
            "--warning-tint": "#3a2e12",
            "--warning-border": "#6a5420",
            "--success": "#86d49b",
            "--success-tint": "#1b3324",
            "--success-border": "#2e5a3a",
            "--scrim": "rgb(0 0 0 / 0.6)"
          }
        },
        "@layer base": {
          "*": {
            "@apply border-border outline-focus": {}
          },
          "body": {
            "@apply bg-background text-foreground": {}
          }
        }
