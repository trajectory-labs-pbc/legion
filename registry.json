        "light": {
          "background": "#eae9e6",
          "foreground": "#141414",
          "card": "#ffffff",
          "card-foreground": "#141414",
          "popover": "#ffffff",
          "popover-foreground": "#141414",
          "primary": "#141414",
          "primary-foreground": "#ffffff",
          "secondary": "#f5f4f2",
