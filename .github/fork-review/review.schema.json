{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings"],
  "properties": {
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "line", "severity", "body"],
        "properties": {
          "path": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "severity": { "enum": ["Minor", "Medium", "High"] },
          "body": { "type": "string" },
          "earlier_comment_id": { "type": ["integer", "null"] }
        }
      }
    }
  }
}
