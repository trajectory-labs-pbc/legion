{
  "name": "@legion/ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "imports": {
    "#registry/legion/ui/*": "./src/components/*.tsx",
    "#registry/legion/blocks/*": "./src/blocks/*.tsx",
    "#registry/legion/lib/*": "./src/lib/*.ts"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./theme.css": "./src/styles/theme.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./blocks/*": "./src/blocks/*.tsx"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "registry": "bun scripts/registry.ts",
    "postinstall": "bun scripts/link-root-packages.ts .",
    "registry:validate": "bunx --bun shadcn registry validate --cwd ../.."
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0"
  },
  "peerDependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.70.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.70.0",
    "postcss": "8.5.32",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3"
  },
  "rootPackages": [
    "@biomejs/biome",
    "@happy-dom/global-registrator",
    "@testing-library/react",
    "@testing-library/user-event",
    "@types/react",
    "@types/react-dom",
    "react",
    "react-dom",
    "typescript"
  ],
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
