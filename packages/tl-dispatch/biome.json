{
  "root": false,
  "extends": "//",
  "overrides": [
    {
      "includes": ["tests/map/copies.json"],
      "formatter": { "enabled": false }
    }
  ],
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@upstream-dispatch/app": "Upstream's app.tsx opens a second sign-in channel when it loads; copy what the shell needs."
            }
          }
        }
      }
    }
  }
}
