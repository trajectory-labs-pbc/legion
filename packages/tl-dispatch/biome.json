{
  "root": false,
  "extends": "//",
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@upstream-dispatch/app": "Upstream's app.tsx opens a second sign-in channel when it loads; copy what the shell needs."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/ui/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ]
}
