{
  "name": "tl-dispatch",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "echo the unit step is skipped on this control branch",
    "build:contracts": "bun run --cwd ../contracts build:dispatch",
    "test:browser": "bun run build:contracts && vite build && bunx playwright test --config e2e/playwright.config.ts --grep \"only-changes: a second tab\" --reporter=list",
    "test:browser:switch": "DISPATCH_E2E_PROCESSES=2 bunx playwright test --config e2e/playwright.config.ts --output e2e/test-results/switch",
    "test:browser:deployed": "bun run build:contracts && bunx playwright test --config e2e/playwright.deployed.config.ts",
    "test:browser:deployed-local": "bun e2e/local-stack.ts",
    "test:browser:upstream": "bunx playwright test --config e2e/playwright.upstream.config.ts",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx biome check .",
    "check:entry-budget": "bun scripts/check-entry-budget.ts",
    "check:parity": "bun scripts/check-parity.ts",
    "postinstall": "bun ../ui/scripts/link-root-packages.ts ."
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.6",
    "lucide-react": "1.70.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "postcss": "8.5.32"
  },
  "rootPackages": [
    "@axe-core/playwright",
    "@biomejs/biome",
    "@happy-dom/global-registrator",
    "@milkdown/kit",
    "@playwright/test",
    "@tailwindcss/vite",
    "@tanstack/react-query",
    "@testing-library/react",
    "@testing-library/user-event",
    "@types/react",
    "@types/react-dom",
    "@vitejs/plugin-react",
    "clsx",
    "msw",
    "prosemirror-model",
    "react",
    "react-dom",
    "react-router-dom",
    "tailwindcss",
    "typescript",
    "vite",
    "yjs"
  ],
  "uiPackages": [
    "@base-ui/react",
    "class-variance-authority",
    "cn",
    "lucide-react"
  ],
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
